# -----------------------------------------------------------
# Vaultwarden (без изменений, только fullchain.cer и http2)
# -----------------------------------------------------------
server {
    listen 80;
    server_name ${VAULTWARDEN_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${VAULTWARDEN_DOMAIN};

    ssl_certificate /etc/nginx/acme.sh/${DOMAIN}_ecc/fullchain.cer;
    ssl_certificate_key /etc/nginx/acme.sh/${DOMAIN}_ecc/${DOMAIN}.key;

    location / {
        proxy_pass http://vaultwarden:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /notifications/hub {
        proxy_pass http://vaultwarden:80;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

