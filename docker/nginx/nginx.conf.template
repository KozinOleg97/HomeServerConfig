ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384';
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# -----------------------------------------------------------
# Основной домен (egoidei.giize.com) – редирект и .well-known
# -----------------------------------------------------------
server {
    listen 80;
    server_name ${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    ssl_certificate /etc/nginx/acme.sh/${DOMAIN}_ecc/fullchain.cer;   # используем fullchain
    ssl_certificate_key /etc/nginx/acme.sh/${DOMAIN}_ecc/${DOMAIN}.key;


    # ============================================
    # Transmission WebUI через поддиректорию /transmission
    # ============================================
    location /transmission/ {

        client_max_body_size 100M;

        # Убираем префикс /transmission из URI, чтобы запросы пошли в корень бэкенда
        rewrite ^/transmission(/.*)$ $1 break;

        proxy_pass http://transmission:9091;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Важно для длительных запросов
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # Подменяем абсолютные пути в ответах, чтобы они указывали на /transmission/
        sub_filter 'href="/' 'href="/transmission/';
        sub_filter 'src="/' 'src="/transmission/';
        sub_filter 'action="/' 'action="/transmission/';
        sub_filter 'var transmission_url = "/transmission/web";' '';
        sub_filter_once off;
        proxy_redirect / /transmission/;
    }


    # ============================================
    # Jellyfin через поддиректорию /jellyfin
    # ============================================
    location /jellyfin/ {
        # Пробрасываем запросы к Jellyfin, сохраняя поддиректорию
        proxy_pass http://jellyfin:8096/jellyfin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Для загрузки субтитров и больших запросов
        client_max_body_size 100M;

        # Обязательно для WebSocket и уведомлений
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Важно: отключаем буферизацию для лучшей производительности
        proxy_buffering off;
    }


    # ============================================
    # WebDAV доступ к файлам
    # ============================================
    location /webdav/ {
        # Убираем префикс /webdav/ из URI перед отправкой на бэкенд
        rewrite ^/webdav(/.*)$ $1 break;

        proxy_pass http://webdav:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Критично для WebDAV-методов (PROPFIND, MKCOL и т.д.)
        proxy_set_header Destination $http_destination;
        proxy_pass_request_headers on;

        # Таймауты и размер загрузки
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        client_max_body_size 0;            # без ограничений
    }

    location /.well-known/matrix/client {
        default_type application/json;
        add_header Access-Control-Allow-Origin *;
        return 200 '{"m.homeserver": {"base_url": "https://${MATRIX_DOMAIN}"}}';
    }

    location /.well-known/matrix/server {
        default_type application/json;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header Access-Control-Allow-Origin *;
        return 200 '{
            "m.server": "${MATRIX_DOMAIN}:8448"
        }';
    }

    # Всё остальное (если нужно) – например, заглушка или статика
    location / {
        return 404;
    }
}

# -----------------------------------------------------------
# Matrix-клиентский поддомен (matrix.egoidei.giize.com)
# -----------------------------------------------------------
server {
    listen 80;
    server_name ${MATRIX_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${MATRIX_DOMAIN};

    client_max_body_size 100M;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    ssl_certificate /etc/nginx/acme.sh/${DOMAIN}_ecc/fullchain.cer;
    ssl_certificate_key /etc/nginx/acme.sh/${DOMAIN}_ecc/${DOMAIN}.key;

    # .well-known для федерации – теперь на самом поддомене Matrix
    location /.well-known/matrix/server {
        default_type application/json;
        add_header Access-Control-Allow-Origin *;
        return 200 '{"m.server": "${MATRIX_DOMAIN}:8448"}';
    }

    # .well-known для клиента на поддомене Matrix
    location /.well-known/matrix/client {
        default_type application/json;
        add_header Access-Control-Allow-Origin *;
        return 200 '{
            "m.homeserver": {"base_url": "https://${MATRIX_DOMAIN}"},
            "livekit_url": "https://${MATRIX_DOMAIN}/livekit-jwt",
            "org.matrix.msc4143.rtc_foci": [
                {
                    "type": "livekit",
                    "livekit_service_url": "https://${MATRIX_DOMAIN}/livekit-jwt"
                }
            ]
        }';
    }




    location / {
        proxy_pass http://tuwunel:6167;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    #Для MatrixRTC Auth Service
    location /livekit-jwt/ {
        proxy_pass http://lk-jwt-service:8081/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

